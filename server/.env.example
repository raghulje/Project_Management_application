# =============================================================================
# Refex Project Management — server env (same pattern as Asset Management)
# Copy to server/.env  — never commit .env
# =============================================================================

PORT=3060
HOST=0.0.0.0
NODE_ENV=development

# Production: Express serves built SPA from ../client/out on the same PORT
# Build first:  cd client && npm ci && npm run build
SERVE_CLIENT=false

FRONTEND_URL=http://localhost:5174
PUBLIC_APP_URL=http://localhost:5174
CLIENT_ORIGIN=http://localhost:5174
FORCE_HTTPS=false

# --- Database (use a NEW database — do not reuse ITAssetManagement_2026) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ProjectManagement_2026
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_this_to_a_secure_random_string_in_production

# --- Adrenalin Live HRMS (copied from Asset Management) ---
ADRENALIN_BASE_URL=https://refex.myadrenalin.com/JASON_DYNAMIC_API/SHERISHA/V1/JasonBase
ADRENALIN_USERNAME=
ADRENALIN_PASSWORD=
ADRENALIN_COMPANY_ID=SHERISHA
ADRENALIN_SYNC_INTERVAL_MINUTES=0

# --- Email ---
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply

# Notifications (set true to send workflow/overdue emails)
NOTIFICATIONS_ENABLED=false

# Kissflow import / dashboard sync (production first, then development)
KF_LIVE_API_ORIGIN=https://refexgroup.kissflow.com
KF_LIVE_ACCOUNT_ID=AcCMptlq60zH
KF_LIVE_ACCESS_KEY_ID=
KF_LIVE_ACCESS_KEY_SECRET=
KF_API_ORIGIN=https://development-refexgroup.kissflow.com
KF_ACCOUNT_ID=AcCMptp3yqcn
KF_ACCESS_KEY_ID=
KF_ACCESS_KEY_SECRET=
